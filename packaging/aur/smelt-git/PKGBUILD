# Maintainer: mhdztr <zakkithoriq@gmail.com>
pkgname=smelt-git
pkgver=0.1.0.r0.g00000000
pkgrel=1
pkgdesc="Advanced document converter CLI - melt any document into any other (git HEAD)"
arch=('x86_64' 'aarch64')
url="https://github.com/mhdztr/smelt"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('git' 'cargo')
provides=('smelt')
conflicts=('smelt')
source=("$pkgname::git+https://github.com/mhdztr/smelt.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # A tagged repo: v0.2.0-3-gabcdef12 -> 0.2.0.r3.gabcdef12 (strip the `v`).
  # An untagged repo (smelt has no tags today) has no `git describe` output,
  # so fall back to a stable base version plus the current commit instead of
  # letting `set -e` abort the build.
  local describe
  if describe="$(git describe --long --tags --abbrev=8 2>/dev/null)"; then
    printf '%s\n' "${describe#v}" | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.1.0.r0.g%s\n' "$(git rev-parse --short=8 HEAD)"
  fi
}

prepare() {
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')" \
    --manifest-path "$pkgname/Cargo.toml"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --manifest-path "$pkgname/Cargo.toml" --release
}

check() {
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --manifest-path "$pkgname/Cargo.toml" --release
}

package() {
  install -Dm755 "$pkgname/target/release/smelt" \
    "$pkgdir/usr/bin/smelt"
  install -Dm644 "$pkgname/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgname/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
